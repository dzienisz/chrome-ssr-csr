{
  "name": "ssr-csr-analytics",
  "version": "1.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:setup": "node scripts/setup-db.js",
    "db:migrate": "node scripts/migrate-db.js",
    "db:purge-non-public": "node scripts/purge-non-public-hosts.js",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit --incremental false",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tremor/react": "^3.18.7",
    "@vercel/analytics": "^1.6.1",
    "@vercel/postgres": "^0.10.0",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@tremor/react": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
